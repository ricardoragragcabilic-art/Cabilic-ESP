-- Function to refresh player list
function RefreshPlayerList()
    for _, child in pairs(PlayerList:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end
    
    local yOffset = 0
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local PlayerButton = Instance.new("TextButton")
            PlayerButton.Size = UDim2.new(1, -10, 0, 15)
            PlayerButton.Position = UDim2.new(0, 5, 0, yOffset)
            PlayerButton.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
            PlayerButton.BackgroundTransparency = 0.3
            PlayerButton.Text = player.Name
            PlayerButton.TextColor3 = Color3.fromRGB(255, 255, 255)
            PlayerButton.TextSize = 7
            PlayerButton.Font = Enum.Font.GothamMedium
            PlayerButton.Parent = PlayerList
            
            local UICorner_Player = Instance.new("UICorner")
            UICorner_Player.CornerRadius = UDim.new(0, 3)
            UICorner_Player.Parent = PlayerButton
            
            if SelectedPlayers[player] then
                PlayerButton.BackgroundColor3 = Color3.fromRGB(255, 150, 0)
                PlayerButton.TextColor3 = Color3.fromRGB(0, 0, 0)
            end
            
            PlayerButton.MouseButton1Click:Connect(function()
                if SelectedPlayers[player] then
                    SelectedPlayers[player] = nil
                    PlayerButton.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
                    PlayerButton.TextColor3 = Color3.fromRGB(255, 255, 255)
                else
                    SelectedPlayers[player] = true
                    PlayerButton.BackgroundColor3 = Color3.fromRGB(255, 150, 0)
                    PlayerButton.TextColor3 = Color3.fromRGB(0, 0, 0)
                end
                
                local count = 0
                for _ in pairs(SelectedPlayers) do count = count + 1 end
                SelectedCountLabel.Text = "Sel: " .. count
                
                if ESPEnabled then
                    if SelectedPlayers[player] then
                        CreateESP(player)
                    else
                        RemoveESP(player)
                    end
                end
            end)
            
            yOffset = yOffset + 18
        end
    end
    
    PlayerList.CanvasSize = UDim2.new(0, 0, 0, yOffset)
end

